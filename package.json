{
  "name": "mobileshop",
  "private": true,
  "description": "MobileFix Pro — Mobile Repair Shop Management Platform (monorepo)",
  "workspaces": [
    "backend",
    "frontend/web",
    "frontend/admin",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @mobileshop/api",
    "dev:web": "npm run dev -w @mobileshop/web",
    "dev:admin": "npm run dev -w @mobileshop/admin",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @mobileshop/db",
    "db:push": "npm run db:push -w @mobileshop/db",
    "db:migrate": "npm run db:migrate -w @mobileshop/db",
    "db:seed": "npm run db:seed -w @mobileshop/db",
    "db:studio": "npm run db:studio -w @mobileshop/db"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
