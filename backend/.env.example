# Copy to .env and fill. Never commit .env (see .gitignore).
NODE_ENV=development
PORT=4000

# Local: `docker compose up -d`  ·  Prod: Railway managed Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mobileshop

JWT_ACCESS_SECRET=dev-access-secret-change-me-please-000
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CLIENT_URL=http://localhost:5173

# Email (Resend). Empty → emails are logged to console in dev.
RESEND_API_KEY=
RESEND_FROM=MobileFix Pro <no-reply@{{DOMAIN}}>

# Dev convenience: echo OTP codes in API responses. Set false in production!
DEV_ECHO_OTP=true

# Cloudinary (Phase 1.5 — uploads). Empty → upload signing returns 501.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
